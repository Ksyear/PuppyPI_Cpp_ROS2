# /etc/puppypi/camera.env — USB 카메라 선택·모드 (puppypi-camera-detect 가 읽음)
# 바꾼 뒤: sudo systemctl restart puppypi-ros2   확인: sudo journalctl -u puppypi-ros2 -b | grep camera-detect
# 여러 대 꽂혀 있을 때 고를 카메라 이름 일부(`ls /dev/v4l/by-id/` 에 보이는 문자열). 없으면 첫 USB 카메라.
CAMERA_NAME=NV50-HD220S
# 장치를 직접 지정하려면 (예: /dev/video0 또는 /dev/v4l/by-id/usb-XXXX-video-index0)
CAMERA_DEVICE=
# 고를 수 있는 최대 해상도·fps (카메라가 지원하는 MJPG 모드 중 이 범위에서 가장 큰 것).
# MJPG 는 로봇 CPU 가 매 프레임 디코딩한다. 1920x1080 은 CPU·Wi-Fi 부담이 커서 기본은 1280x720.
MAX_WIDTH=1280
MAX_HEIGHT=720
MAX_FPS=30
MIN_FPS=15
# 색이 깨지면 직접 지정: YUVJ422P(4:2:2) / YUVJ420P(4:2:0) / YUVJ444P. 비우면 한 프레임을 읽어 자동.
AV_DEVICE_FORMAT=
# /usb_cam/image_raw/compressed(맥북 조종기·type=ros_compressed) JPEG 품질 10~100. 높을수록 선명하지만 Wi-Fi 부담 증가
JPEG_QUALITY=80
# 카메라 조정값: 시작할 때마다 카메라 자체 기본값으로 되돌리고 자동 노출·자동 화이트밸런스를 켠다.
# 그래도 어두우면 아래 주석을 풀어 조정(이름·범위는 부팅 로그의 "조정값(현재/기본/범위)" 줄 또는 v4l2-ctl -d /dev/video0 --list-ctrls).
# CTRL_brightness=
# CTRL_gain=
# 어두운 곳에서 노출 시간을 늘리도록 허용(밝아지지만 fps 가 15 이하로 떨어질 수 있음)
# CTRL_exposure_dynamic_framerate=1

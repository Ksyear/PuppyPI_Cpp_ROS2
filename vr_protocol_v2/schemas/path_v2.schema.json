{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "puppypi/protocol-v2/path",
  "title": "PuppyPi Protocol v2 path / path_cancel (VR → robot). 경유점은 지도 좌표(m). 조종자만, 연결 뒤 중립 확인 뒤에만 수락. ACK 는 command 와 같은 8필드",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "protocol": {"const": 2},
        "type": {"const": "path"},
        "client_id": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "points": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {"type": "array", "minItems": 2, "maxItems": 2,
                    "items": {"type": "number", "minimum": -100, "maximum": 100}}
        }
      },
      "required": ["protocol", "type", "client_id", "sequence", "points"],
      "additionalProperties": false
    },
    {
      "properties": {
        "protocol": {"const": 2},
        "type": {"const": "path_cancel"},
        "client_id": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      },
      "required": ["protocol", "type", "client_id", "sequence"],
      "additionalProperties": false
    }
  ]
}
